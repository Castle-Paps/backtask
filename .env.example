# ──────────────────────────────────────────────────────────────────────────────
# RegistroTareas — Variables de entorno
# ──────────────────────────────────────────────────────────────────────────────

# ── Base de datos ─────────────────────────────────────────────────────────────
DB_NAME=tareas
DB_USERNAME=postgres
DB_PASSWORD=CAMBIA_ESTO_contrasena_segura

# ── JWT ───────────────────────────────────────────────────────────────────────
# Genera en: https://generate-secret.vercel.app/64
JWT_SECRET=CAMBIA_ESTO_secreto_minimo_32_caracteres_aleatorios
JWT_EXPIRATION_MS=86400000

# ── Google Drive — OAuth 2.0 Desktop ─────────────────────────────────────────
# 1. console.cloud.google.com → APIs → Credenciales → OAuth 2.0 (Desktop)
# 2. Refresh Token via: https://developers.google.com/oauthplayground/
#    Scope: https://www.googleapis.com/auth/drive.file
GOOGLE_CLIENT_ID=xxxxxxxxxx-xxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_REFRESH_TOKEN=1//xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_DRIVE_ROOT_FOLDER=RegistroTareas

# ── Cloudflare Tunnel ─────────────────────────────────────────────────────────
# 1. Cloudflare Zero Trust → Networks → Tunnels → Create a tunnel
# 2. Copiar el token que aparece en el comando de instalación
# 3. Configurar Public Hostname: task.yzulatecperu.uk → http://app:8088
CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoixxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Hibernate DDL (producción = validate, desarrollo = create-drop) ───────────
DDL_AUTO=validate
